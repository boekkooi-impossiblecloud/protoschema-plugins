{
  "$defs": {
    "buf.protoschema.test.v1.JSONNameCollision.schema.strict.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "allOf": [
        {
          "oneOf": [
            {
              "required": [
                "baz_qux"
              ]
            },
            {
              "required": [
                "qux"
              ]
            },
            {
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "baz_qux"
                    ]
                  },
                  {
                    "required": [
                      "qux"
                    ]
                  }
                ]
              }
            }
          ]
        }
      ],
      "properties": {
        "bar": {
          "maximum": 2147483647,
          "minimum": -2147483648,
          "type": "integer"
        },
        "baz_qux": {
          "type": "string"
        },
        "foo_bar": {
          "type": "string"
        },
        "qux": {
          "type": "string"
        }
      },
      "required": [
        "foo_bar",
        "bar"
      ],
      "title": "JSON Name Collision",
      "type": "object"
    }
  },
  "$id": "buf.protoschema.test.v1.JSONNameCollision.schema.strict.bundle.json",
  "$ref": "#/$defs/buf.protoschema.test.v1.JSONNameCollision.schema.strict.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
